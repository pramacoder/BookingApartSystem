# Supabase (PostgreSQL) Configuration
# Dapatkan URL dan Anon Key dari dashboard Supabase: https://app.supabase.com
# Buka Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_key

# Midtrans Payment Gateway Configuration (Optional)
# Dapatkan dari: https://dashboard.midtrans.com
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
VITE_MIDTRANS_SERVER_KEY=your_midtrans_server_key
